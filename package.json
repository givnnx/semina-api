  "private": true,
  "scripts": {
    "start": "node dist/bin/www.js",
    "dev": "nodemon --exec ts-node --transpile-only src/bin/www.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.cpSync('src/swagger.yaml', 'dist/swagger.yaml'); fs.cpSync('src/app/views', 'dist/app/views', { recursive: true });\"",
    "seed:admin": "ts-node src/seed/admin.ts",
    "scrape:seed": "ts-node src/seed/scrapeWithAgentBrowser.ts",
