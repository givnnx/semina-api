    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.10.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mustache": "^4.2.0",
    "nodemailer": "^10.3.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
