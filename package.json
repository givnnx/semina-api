{
  "name"           : "be-semina",
  "version"        : "0.0.0",
  "private"        : true,
  "scripts"        : {
    "start"     : "node dist/bin/www.js",
    "dev"       : "nodemon --exec ts-node src/bin/www.ts",
    "build"     : "tsc && copyfiles -u 1 src/swagger.yaml dist",
    "seed:admin": "ts-node src/seed/admin.ts",
    "seed"      : "ts-node src/seed/seed.ts",
    "vercel:env": "ts-node src/scripts/vercel-env.ts"
  },
  "dependencies"   : {
    "bcryptjs"          : "latest",
    "cookie-parser"     : "latest",
    "cors"              : "latest",
    "debug"             : "latest",
    "dotenv"            : "latest",
    "express"           : "latest",
    "http-status-codes" : "latest",
    "jsonwebtoken"      : "latest",
    "mongoose"          : "latest",
    "morgan"            : "latest",
    "multer"            : "latest",
    "mustache"          : "latest",
    "nodemailer"        : "latest",
    "swagger-ui-express": "^5.0.1",
    "yamljs"            : "^0.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs"          : "^2.4.6",
    "@types/cookie-parser"     : "^1.4.10",
    "@types/cors"              : "^2.8.19",
    "@types/debug"             : "^4.1.12",
    "@types/express"           : "^5.0.6",
    "@types/jsonwebtoken"      : "^9.0.10",
    "@types/morgan"            : "^1.9.10",
    "@types/multer"            : "^2.0.0",
    "@types/mustache"          : "^4.2.6",
    "@types/node"              : "^25.2.0",
    "@types/nodemailer"        : "^7.0.9",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs"            : "^0.2.34",
    "@vercel/node"             : "^5.5.28",
    "copyfiles"                : "^2.4.1",
    "nodemon"                  : "latest",
    "ts-node"                  : "^10.9.2",
    "typescript"               : "^5.9.3"
  }
}
